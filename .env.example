# CMM Routers — local bearer tokens only.
# Host is fixed to 127.0.0.1 by schema; port lives in config/shared.json.
# Copy nothing secret into git: this file holds only the token variable names.
#
# CMM_ROUTER_TOKEN authenticates the CMMChat consumer, which is permanently
# CHAT_ONLY on every provider (no tools, no shell, no edits).
CMM_ROUTER_TOKEN=
#
# CMM_QODER_TOKEN is optional. When set, requests presenting this bearer are
# the Qoder consumer, which may use tools ONLY on providers whose structured
# upstream round-trip is proven (CHAT_AND_TOOLS). When unset, there is no
# Qoder consumer and every client is CMMChat.
CMM_QODER_TOKEN=
#
# Cavoti is an explicit PAYG route. It remains disabled in shared config and
# also requires a separate machine-local spend acknowledgement before the
# Router will register it. This example intentionally contains no secret value.
CAVOTI_API_KEY=
#
# Approved provider wave. Each provider is disabled in shared config by default
# and owns exactly one variable NAME below; no provider may read another
# provider's variable, and the reserved PAYG fallback names (OPENAI_API_KEY,
# ANTHROPIC_API_KEY, GEMINI_API_KEY, GOOGLE_API_KEY) are refused outright.
#
# Qwen Token Plan and Qwen Cloud PAYG are separate products with separate keys,
# billing classes and usage accounts; never point one at the other's key.
QWEN_TOKEN_PLAN_API_KEY=
QWEN_CLOUD_API_KEY=
DEEPSEEK_API_KEY=
KIRA_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_ZEN_API_KEY=
NVIDIA_NIM_API_KEY=
VIKEY_API_KEY=
CLINE_API_KEY=
OLLAMA_CLOUD_API_KEY=
# Command Code keeps its own spend-acknowledgement gate.
COMMAND_CODE_SECRET=
